Bootstrap: docker
From: registry.access.redhat.com/ubi8/ubi

%post
    dnf -y update && dnf -y install \
        gcc \
        gcc-c++ \
        make \
        cmake \
        git \
        curl \
        autoconf \
        automake \
        libtool \
        perl \
        perl-IPC-Cmd \
        diffutils \
        file \
        patch \
        tar \
        gzip \
        which \
        findutils \
        && dnf clean all

    # Clone the ttyd repository
    git clone https://github.com/hansen-m/ttyd.git /ttyd

    # Optional ttyd credential patch
    # sed -i '/server = server_new(argc, argv, start);/a\
    # const char *env_credential = getenv("TTYD_CREDENTIAL");\
    # if (env_credential != NULL) {\
    #     char b64_text[256];\
    #     lws_b64_encode_string(env_credential, strlen(env_credential), b64_text, sizeof(b64_text));\
    #     server->credential = strdup(b64_text);\
    # }' /ttyd/src/server.c

    cd /ttyd

    # Override broken upstream default
    export ZLIB_VERSION=1.4

    ./scripts/cross-build.sh

%runscript
    exec /opt/stage/x86_64-linux-musl/bin/ttyd "$@"
